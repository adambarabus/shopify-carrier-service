# ============================================================
# ENVIRONMENT VARIABLES
# ============================================================
# Copy this file to .env for local development.
# In Vercel, set these via the Vercel dashboard (never commit .env).
# ============================================================

# Your Shopify store domain (no https://)
SHOPIFY_SHOP=3hvdwy-f0.myshopify.com

# Client ID from your Shopify custom app Settings page
SHOPIFY_CLIENT_ID=your_client_id_here

# Client Secret from your Shopify custom app Settings page
# This is also used to verify incoming webhooks are genuine
SHOPIFY_CLIENT_SECRET=your_client_secret_here

# Optional: path for the SQLite cache file (defaults to /tmp/cache.db)
# DB_PATH=/tmp/cache.db
