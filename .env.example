# ============================================================
# ENVIRONMENT VARIABLES
# ============================================================
# Copy this file to .env for local development.
# In Vercel, set these via the Vercel dashboard (never commit .env).
# ============================================================

# Your Shopify store domain (no https://)
SHOPIFY_SHOP=3hvdwy-f0.myshopify.com

# Client ID from your Shopify custom app Settings page
SHOPIFY_CLIENT_ID=your_client_id_here

# Client Secret from your Shopify custom app Settings page
SHOPIFY_CLIENT_SECRET=your_client_secret_here

# Vercel Edge Config connection string (auto-injected by Vercel when connected)
EDGE_CONFIG=your_edge_config_connection_string_here

# Edge Config store ID (e.g. ecfg_xxxxxxxxxxxx)
EDGE_CONFIG_ID=ecfg_dsxtljabczeitwvibbfd6hpcc5ue

# Vercel API token for writing to Edge Config
VERCEL_API_TOKEN=your_vercel_api_token_here
